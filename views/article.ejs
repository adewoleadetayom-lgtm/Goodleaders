<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title><%= post.title %> - GoodLeaders</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f7fb;
    color:#222;
}

header{
    background:#1e40af;
    color:white;
    padding:25px 20px;
    text-align:center;
}

.container{
    max-width:900px;
    margin:30px auto;
    padding:20px;
}

.article{
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0 3px 12px rgba(0,0,0,.08);
}

.article h1{
    color:#1e40af;
    margin-bottom:15px;
}

.date{
    color:#64748b;
    margin-bottom:25px;
    font-size:14px;
}

.content{
    line-height:1.8;
    white-space:pre-line;
    font-size:17px;
}

.btn{
    display:inline-block;
    margin-top:25px;
    padding:12px 20px;
    background:#2563eb;
    color:white;
    text-decoration:none;
    border-radius:8px;
}

footer{
    background:#1e40af;
    color:white;
    text-align:center;
    padding:25px;
    margin-top:40px;
}
</style>
</head>

<body>

<header>

<h1>📖 GoodLeaders</h1>

<p>Leadership Education & Inspiration</p>

</header>

<div class="container">

<div class="article">

<h1><%= post.title %></h1>

<p class="date">
Published: <%= post.date %>
</p>

<div class="content">
<%= post.content %>
</div>

<% if (typeof isAdmin !== "undefined" && isAdmin) { %>

<form
    action="/admin/delete-post/<%= post.id %>"
    method="POST"
    onsubmit="return confirm('Are you sure you want to permanently delete this article?');"
    style="margin-top:20px;"
>
    <button
        type="submit"
        style="
            background:#dc2626;
            color:white;
            border:none;
            padding:10px 15px;
            border-radius:7px;
            cursor:pointer;
        "
    >
        🗑️ Delete Article
    </button>
</form>

<% } %>

<hr style="
margin:30px 0;
border:none;
border-top:1px solid #e5e7eb;
">

<h2 style="
color:#1e40af;
margin-bottom:15px;
">
📚 More Leadership Articles
</h2>

<% if(dbPosts && dbPosts.length > 0){ %>

<% dbPosts.forEach(function(item, i){ %>

<% if(i !== dbPosts.indexOf(post)){ %>

<div style="
padding:15px 0;
border-bottom:1px solid #eee;
">

<h3>
<%= item.title %>
</h3>

<p style="
color:#64748b;
margin-top:8px;
">
<%= item.content.substring(0,120) %>...
</p>

<a href="/article/<%= i %>" style="
display:inline-block;
margin-top:8px;
padding:8px 12px;
background:#2563eb;
color:white;
text-decoration:none;
border-radius:6px;
">
📖 Read Article
</a>

</div>

<% } %>

<% }) %>

<% } else { %>

<p>No other leadership articles are available yet.</p>

<% } %>

<a href="/dashboard" class="btn">
⬅ Back to Dashboard
</a>

</div>

</div>

<footer>

<p>GoodLeaders Platform</p>

<p>Empowering Tomorrow's Leaders.</p>

<p>&copy; 2026 GoodLeaders. All Rights Reserved.</p>

</footer>

</body>
</html>
