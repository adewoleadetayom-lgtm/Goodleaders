<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GoodLeaders Chat</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#eef3f8;
    height:100vh;
    display:flex;
    flex-direction:column;
}

/* HEADER */

header{
    background:#1e40af;
    color:white;
    padding:16px;
    font-size:22px;
    font-weight:bold;
    text-align:center;
}

/* MAIN CHAT */

.chat-container{
    display:flex;
    flex:1;
    overflow:hidden;
}

/* SIDEBAR */

.sidebar{
    width:280px;
    background:white;
    border-right:1px solid #ddd;
    overflow-y:auto;
}

.sidebar h3{
    padding:15px;
    background:#2563eb;
    color:white;
    font-size:18px;
}

.user{
    display:block;
    padding:15px;
    border-bottom:1px solid #eee;
    cursor:pointer;
    text-decoration:none;
    color:#222;
    transition:.2s;
}

.user:hover{
    background:#eff6ff;
}

/* CHAT AREA */

.chat-area{
    flex:1;
    display:flex;
    flex-direction:column;
    min-width:0;
}

/* CHAT HEADER */

.chat-header{
    background:white;
    padding:15px;
    border-bottom:1px solid #ddd;
    font-weight:bold;
    font-size:17px;
}

/* MESSAGES */

.messages{
    flex:1;
    padding:20px;
    overflow-y:auto;
    background:#f8fafc;
    display:flex;
    flex-direction:column;
}

/* MESSAGE ROW */

.message-row{
    display:flex;
    margin-bottom:12px;
}

.message-row.you{
    justify-content:flex-end;
}

.message-row.other{
    justify-content:flex-start;
}

/* MESSAGE BUBBLE */

.message{
    max-width:70%;
    padding:11px 14px;
    border-radius:16px;
    word-wrap:break-word;
}

.message-row.other .message{
    background:white;
    border:1px solid #e5e7eb;
    border-bottom-left-radius:4px;
}

.message-row.you .message{
    background:#2563eb;
    color:white;
    border-bottom-right-radius:4px;
}

.message-name{
    font-size:12px;
    font-weight:bold;
    margin-bottom:4px;
}

.message-row.other .message-name{
    color:#2563eb;
}

.message-row.you .message-name{
    color:#dbeafe;
}

.message-text{
    font-size:15px;
    line-height:1.4;
}

.message-time{
    font-size:10px;
    margin-top:5px;
    opacity:.7;
}

/* INPUT */

.input-area{
    display:flex;
    padding:12px;
    background:white;
    border-top:1px solid #ddd;
    gap:8px;
}

.input-area input[type="text"]{
    flex:1;
    min-width:0;
    padding:12px;
    border:1px solid #ccc;
    border-radius:22px;
    font-size:15px;
    outline:none;
}

.input-area input[type="text"]:focus{
    border-color:#2563eb;
}

.input-area button{
    padding:12px 20px;
    background:#2563eb;
    color:white;
    border:none;
    border-radius:22px;
    cursor:pointer;
    font-weight:bold;
}

.input-area button:hover{
    background:#1d4ed8;
}

/* EMPTY CHAT */

.empty-chat{
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    color:#64748b;
    padding:30px;
}

/* MOBILE */

@media(max-width:700px){

    .sidebar{
        width:105px;
    }

    .sidebar h3{
        font-size:13px;
        padding:12px 6px;
        text-align:center;
    }

    .user{
        padding:12px 5px;
        text-align:center;
        font-size:12px;
        overflow:hidden;
    }

    .message{
        max-width:85%;
    }

    .chat-header{
        font-size:14px;
        padding:12px;
    }

    .messages{
        padding:12px;
    }

    .input-area{
        padding:9px;
    }

    .input-area button{
        padding:10px 14px;
    }

}

</style>

</head>

<body>

<header>
💬 GoodLeaders Chat
</header>

<div class="chat-container">

<!-- MEMBERS -->

<div class="sidebar">

<h3>Members</h3>

<a
    href="/chat?group=main"
    class="user"
    style="
        display:flex;
        align-items:center;
        gap:8px;
        text-decoration:none;
        color:inherit;
        font-weight:bold;
    "
>
    👥 GoodLeaders Group
</a>

<% users.forEach(member => { %>

    <% if (member.email !== user) { %>

        <a
    href="/chat?user=<%= encodeURIComponent(member.email) %>"
    class="user"
    style="display:flex;align-items:center;justify-content:space-between;text-decoration:none;color:inherit;"
>
   <span style="display:flex;align-items:center;gap:6px;">
    <span>
        <%= member.is_online ? "🟢" : "⚪" %>
    </span>
    <span>
        👤 <%= member.username %>
    </span>
</span>

    <% if (Number(member.unread_count) > 0) { %>
        <span
            style="
                background:#ef4444;
                color:white;
                border-radius:999px;
                padding:3px 8px;
                font-size:12px;
                font-weight:bold;
            "
        >
            <%= member.unread_count %>
        </span>
    <% } %>
</a>

    <% } %>

<% }) %>

</div>


<!-- CHAT AREA -->

<div class="chat-area">

<!-- CHAT HEADER -->

<div class="chat-header">

    <% const safePrivateFiles = typeof privateFiles !== 'undefined' ? privateFiles : []; %>

<% if (groupChat) { %>

        👥 GoodLeaders Group Chat


<% safePrivateFiles.forEach(file => { %>

    <% const isYou = file.sender === user; %>

    <div class="message-row <%= isYou ? 'you' : 'other' %>">

        <div class="message">

            <div class="message-name">
                <%= isYou ? "You" : file.sender %>
            </div>

            <div class="message-text">

                📎 <strong>
                    <%= file.original_name %>
                </strong>

                <br>

                <small>
                    <%= (Number(file.file_size) / 1024 / 1024).toFixed(2) %> MB
                </small>

                <br>

                <a
                    href="/private-uploads/<%= encodeURIComponent(file.stored_name) %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    style="color:inherit;font-weight:bold;"
                >
                    📥 Open / Download
                </a>

            </div>

            <div class="message-time">
                <%= file.date %>
            </div>

        </div>

    </div>

<% }) %>

<% } else if (selectedUser) { %>

        💬 Chat with <%= selectedUser %>



<form
    action="/chat/private-upload"
    method="POST"
    enctype="multipart/form-data"
    class="input-area"
    style="border-top:none;"
>

    <input
        type="hidden"
        name="receiver"
        value="<%= selectedUser %>"
    >

    <input
        type="file"
        name="privateFile"
        accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.mp4,.webm,.mov,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt"
        required
    >

    <button type="submit">
        📎 Send File
    </button>

</form>

<% } else { %>

        💬 Select a member or the group chat

    <% } %>

</div>


<!-- MESSAGES -->

<% if (groupChat) { %>

<div class="messages" id="messages">

<% if (groupMessages.length === 0 && groupFiles.length === 0) { %>

    <div class="empty-chat">
        <div>
            <h3>👥 Welcome to the Group Chat</h3>
            <p>Send a message or share a file with the group.</p>
        </div>
    </div>

<% } %>

<% groupMessages.forEach(message => { %>

    <% const isYou = message.sender === user; %>

    <div class="message-row <%= isYou ? 'you' : 'other' %>">

        <div class="message">

            <div class="message-name">
                <%= isYou ? "You" : message.sender %>
            </div>

            <div class="message-text">
                <%= message.content %>
            </div>

            <div class="message-time">
                <%= message.date %>
            </div>

        </div>

    </div>

<% }) %>

<% groupFiles.forEach(file => { %>

    <% const isYou = file.sender === user; %>

    <div class="message-row <%= isYou ? 'you' : 'other' %>">

        <div class="message">

            <div class="message-name">
                <%= isYou ? "You" : file.sender %>
            </div>

            <div class="message-text">

                📎 <strong><%= file.original_name %></strong>

                <br>

                <small>
                    <%= (Number(file.file_size) / 1024 / 1024).toFixed(2) %> MB
                </small>

                <br>

                <a
                    href="/group-uploads/<%= encodeURIComponent(file.stored_name) %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    style="color:inherit;font-weight:bold;"
                >
                    📥 Open / Download
                </a>

            </div>

            <div class="message-time">
                <%= file.date %>
            </div>

        </div>

    </div>

<% }) %>

</div>

<form
    action="/chat/group-send"
    method="POST"
    class="input-area"
>

    <input
        type="text"
        name="content"
        placeholder="Message the group..."
        autocomplete="off"
        required
    >

    <button type="submit">
        Send
    </button>

</form>

<form
    action="/chat/group-upload"
    method="POST"
    enctype="multipart/form-data"
    class="input-area"
    style="border-top:none;"
>

    <input
        type="file"
        name="groupFile"
        accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.mp4,.webm,.mov,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt"
        required
    >

    <button type="submit">
        📎 Send File
    </button>

</form>

<% } else if (selectedUser) { %>

<div class="messages" id="messages">

<% if (messages.length === 0) { %>

    <div class="empty-chat">
        <div>
            <h3>💬 No messages yet</h3>
            <p>Send the first message!</p>
        </div>
    </div>

<% } %>


<% messages.forEach(message => { %>

    <% const isYou = message.sender === user; %>

    <div class="message-row <%= isYou ? 'you' : 'other' %>">

        <div class="message">

            <div class="message-name">

                <%= isYou ? "You" : message.sender %>

            </div>

            <div class="message-text">

                <%= message.content %>

            </div>

            <div class="message-time">

                <%= message.date %>

            </div>

        </div>

    </div>

<% }) %>

</div>


<!-- SEND MESSAGE -->

<form
    action="/chat/send"
    method="POST"
    class="input-area"
>

    <input
        type="hidden"
        name="receiver"
        value="<%= selectedUser %>"
    >

    <input
        type="text"
        name="content"
        placeholder="Type your message..."
        autocomplete="off"
        required
    >

    <button type="submit">
        Send
    </button>

</form>


<% } else { %>

<div class="empty-chat">

    <div>

        <h2>💬 GoodLeaders Chat</h2>

        <p>
            Select a member from the left to start a private conversation.
        </p>

    </div>

</div>

<% } %>

</div>

</div>


<!-- AUTO-SCROLL TO LATEST MESSAGE -->

<script>

const messagesBox = document.getElementById("messages");

if(messagesBox){

    messagesBox.scrollTop = messagesBox.scrollHeight;

}

</script>

<script>
setInterval(() => {
    const active = document.activeElement;

    if (
        active &&
        (
            active.tagName === "INPUT" ||
            active.tagName === "TEXTAREA"
        )
    ) {
        return;
    }

    window.location.reload();
}, 5000);
</script>

</body>
</html>

