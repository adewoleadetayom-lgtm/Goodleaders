<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GoodLeaders Admin Panel</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#eef3f8;
}

.header{
background:#1e40af;
color:white;
padding:18px 25px;
display:flex;
justify-content:space-between;
align-items:center;
box-shadow:0 2px 10px rgba(0,0,0,.15);
}

.header h1{
font-size:28px;
}

.container{
max-width:1200px;
margin:30px auto;
padding:20px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
margin-bottom:30px;
}

.card{
background:white;
padding:25px;
border-radius:15px;
text-align:center;
box-shadow:0 2px 12px rgba(0,0,0,.08);
}

.card h3{
color:#2563eb;
margin-bottom:15px;
}

.number{
font-size:42px;
font-weight:bold;
color:#1e40af;
}

.section{
background:white;
padding:25px;
margin-bottom:30px;
border-radius:15px;
box-shadow:0 2px 12px rgba(0,0,0,.08);
}

input, textarea, select{
width:100%;
padding:12px;
margin-top:8px;
margin-bottom:15px;
border:1px solid #ccc;
border-radius:8px;
}

button{
background:#2563eb;
color:white;
padding:12px 20px;
border:none;
border-radius:8px;
cursor:pointer;
}

button:hover{
background:#1d4ed8;
}

</style>

</head>

<body>

<div class="header">
<h1>👑 GoodLeaders Admin Panel</h1>
<a href="/dashboard" style="color:white;text-decoration:none;">🏠 Dashboard</a>
</div>

<div class="container">

<div class="cards">

<div class="card">
<h3>👥 Members</h3>
<div class="number"><%= users %></div>
</div>

<div class="card">
<h3>📝 Posts</h3>
<div class="number"><%= posts %></div>
</div>

<div class="card">
<h3>📢 Announcements</h3>
<div class="number"><%= announcements %></div>
</div>

<div class="card">
<h3>📚 Library</h3>
<div class="number"><%= library %></div>
</div>

</div>
<!-- Leadership Advice -->

<div class="section">

<h2>📝 Publish Leadership Advice</h2>

<form action="/admin/post" method="POST">

<label>Title</label>
<input type="text" name="title" required>

<label>Content</label>
<textarea name="content" rows="8" required></textarea>

<button type="submit">Publish Advice</button>

</form>

</div>

<!-- Announcement -->

<div class="section">

<h2>📢 Create Announcement</h2>

<form action="/admin/announcement" method="POST">

<label>Title</label>
<input type="text" name="title" required>

<label>Announcement</label>
<textarea name="content" rows="6" required></textarea>

<button type="submit">Post Announcement</button>

</form>

</div>

<!-- Upload Resource -->

<div class="section">

<h2>📤 Upload Library Resource</h2>

<form action="/admin/library" method="POST" enctype="multipart/form-data">

<label>Resource Title</label>
<input type="text" name="title" required>

<label>Description</label>
<textarea name="description" rows="5"></textarea>

<label>Resource Type</label>
<select name="type" required>

<option value="pdf">📄 PDF</option>
<option value="image">🖼 Image</option>
<option value="video">🎬 Video</option>
<option value="audio">🎵 Audio</option>
<option value="doc">📃 Document</option>
<option value="zip">📦 ZIP</option>
<option value="link">🔗 Link</option>

</select>

<label>Select File</label>
<input
    type="file"
    name="file"
    accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.zip"
>

<label>External Link (for Link type only)</label>

<input
    type="url"
    name="link"
    placeholder="https://example.com"
>

<button type="submit">
    📤 Upload Resource
</button>

</form>

</div>

<!-- Quick Actions -->

<div class="section">

<h2>⚙️ Quick Actions</h2>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px;">

<a href="/dashboard" style="text-decoration:none;background:#2563eb;color:white;padding:15px;text-align:center;border-radius:8px;">🏠 Dashboard</a>

<a href="/profile" style="text-decoration:none;background:#16a34a;color:white;padding:15px;text-align:center;border-radius:8px;">👤 My Profile</a>

<a href="/library" style="text-decoration:none;background:#ea580c;color:white;padding:15px;text-align:center;border-radius:8px;">📚 Library</a>

<a href="/announcements" style="text-decoration:none;background:#475569;color:white;padding:15px;text-align:center;border-radius:8px;">📢 Announcements</a>

<a href="/contact-messages" style="text-decoration:none;background:#7c3aed;color:white;padding:15px;text-align:center;border-radius:8px;">📩 Contact Messages</a>

<a href="/users" style="text-decoration:none;background:#dc2626;color:white;padding:15px;text-align:center;border-radius:8px;">👥 Registered Users</a>

</div>

</div>

<footer style="text-align:center;margin-top:40px;padding:20px;color:#666;">
© 2026 GoodLeaders. All Rights Reserved.
</footer>

</div>

</body>
</html>





























	





















	
























