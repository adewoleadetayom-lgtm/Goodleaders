<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Profile | GoodLeaders</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#eef3f8;
}

.header{
background:#1e40af;
color:white;
padding:18px;
text-align:center;
font-size:28px;
font-weight:bold;
box-shadow:0 2px 10px rgba(0,0,0,.2);
}

.container{
max-width:1000px;
margin:40px auto;
padding:20px;
}

.card{
background:white;
border-radius:18px;
box-shadow:0 5px 20px rgba(0,0,0,.08);
overflow:hidden;
}

.top{
background:#2563eb;
color:white;
padding:40px;
text-align:center;
}

.avatar{
width:150px;
height:150px;
border-radius:50%;
object-fit:cover;
border:5px solid white;
background:white;
}

.no-photo{
width:150px;
height:150px;
margin:auto;
border-radius:50%;
background:white;
display:flex;
align-items:center;
justify-content:center;
font-size:60px;
color:#2563eb;
}

.name{
font-size:30px;
margin-top:20px;
}

.email{
margin-top:10px;
opacity:.95;
}

.info{
padding:35px;
display:grid;
grid-template-columns:1fr 1fr;
gap:20px;
}

.box{
background:#f8fafc;
padding:20px;
border-radius:12px;
}

.box h3{
color:#2563eb;
margin-bottom:10px;
}

.bio{
grid-column:1/3;
}

.actions{
padding:30px;
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.btn{
background:#2563eb;
color:white;
padding:14px 24px;
border-radius:8px;
text-decoration:none;
font-weight:bold;
}

.btn:hover{
background:#1d4ed8;
}

@media(max-width:768px){

.info{
grid-template-columns:1fr;
}

.bio{
grid-column:auto;
}

}

</style>

</head>

<body>

<div class="header">
GoodLeaders
</div>

<div class="container">

<div class="card">

<div class="top">

<% if(user.photo){ %>

<img src="<%= user.photo %>" class="avatar">

<% }else{ %>

<div class="no-photo">
👤
</div>

<% } %>

<div class="name"><%= user.username %></div>

<div class="email"><%= user.email %></div>

</div>

<div class="info">

<div class="box">
<h3>📱 Phone</h3>
<p><%= user.phone || "Not added yet" %></p>
</div>

<div class="box">
<h3>🌍 Country</h3>
<p><%= user.country || "Not added yet" %></p>
</div>

<div class="box bio">
<h3>📝 Biography</h3>
<p><%= user.bio || "Tell everyone about yourself by editing your profile." %></p>
</div>

</div>

<div class="actions">

<a class="btn" href="/edit-profile">
✏️ Edit Profile
</a>

<a class="btn" href="/dashboard">
🏠 Dashboard
</a>

</div>

</div>

</div>

</body>
</html>
