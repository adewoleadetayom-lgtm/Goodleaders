<!DOCTYPE html>
<html lang="en">
<head>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2438599256882908" crossorigin="anonymous"></script>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GoodLeaders Dashboard</title>

<style>

{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f7fb;
color:#222;
}

.header{
background:#1e40af;
color:white;
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 20px;
position:sticky;
top:0;
z-index:1000;
box-shadow:0 2px 10px rgba(0,0,0,.15);
}

.left{
display:flex;
align-items:center;
gap:15px;
}

.logo{
font-size:28px;
font-weight:bold;
}

#menuBtn{
background:none;
border:none;
color:white;
font-size:28px;
cursor:pointer;
}

.menu{
display:flex;
gap:20px;
}

.menu a{
color:white;
text-decoration:none;
font-weight:bold;
}

.menu a:hover{
text-decoration:underline;
}

.sidebar{
position:fixed;
top:0;
left:-270px;
width:250px;
height:100%;
background:#1f2937;
padding-top:70px;
transition:left .3s ease;
z-index:2000;
}

.sidebar.show{
left:0;
}

.sidebar a{
display:block;
padding:15px 20px;
color:white;
text-decoration:none;
}

.sidebar a:hover{
background:#374151;
}

#overlay{
display:none;
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:rgba(0,0,0,.4);
z-index:1500;
}

.hero{
background:white;
margin:25px;
padding:30px;
border-radius:15px;
text-align:center;
box-shadow:0 3px 15px rgba(0,0,0,.08);
}

.hero h1{
color:#1e40af;
margin-bottom:10px;
}

.hero p{
color:#666;
font-size:18px;
}

@media(max-width:768px){

.menu{
display:none;
}

}

</style>

</head>

<body>

<header class="header">

<div class="left">

<button id="menuBtn">
☰
</button>

<div class="logo">
GoodLeaders
</div>

</div>

<div class="menu">

<a href="/dashboard">Dashboard</a>

<a href="/profile">Profile</a>

<a href="/library">Library</a>

<a href="/announcements">Announcements</a>

<a href="/logout">Logout</a>

</div>

</header>

<nav id="sidebar" class="sidebar">

<a href="/dashboard">🏠 Dashboard</a>

<a href="/profile">👤 My Profile</a>

<a href="/about">ℹ️ About Us</a>

<a href="/contact">📩 Contact Us</a>

<a href="/privacy">🔒 Privacy Policy</a>

<a href="/terms">📜 Terms & Conditions</a>

<a href="/cookies">🍪 Cookie Policy</a>

<a href="/library">📚 Library</a>

<a href="/announcements">📢 Announcements</a>

<a href="/admin">⚙️ Admin Panel</a>

<a href="/chat">💬 Chat</a>

<a href="/logout">🚪 Logout</a>

</nav>

<div id="overlay"></div>

<div class="hero">

<h1>Welcome, <%= user %></h1>

<p>Lead with integrity. Inspire people. Build a better future.</p>

</div>
<div class="search" style="text-align:center;margin:25px;">

<form action="/search" method="GET">

<input
type="text"
name="q"
placeholder="Search articles, announcements or library..."
required
style="
width:70%;
max-width:550px;
padding:14px;
border:1px solid #ddd;
border-radius:8px;
font-size:16px;
">

<button type="submit" style="
padding:14px 20px;
margin-left:5px;
background:#2563eb;
color:white;
border:none;
border-radius:8px;
font-size:16px;
cursor:pointer;
">
🔎 Search
</button>

</form>

</div>

<div class="stats" style="
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
margin:30px;
">

<div class="card" style="
background:white;
width:220px;
padding:25px;
border-radius:14px;
text-align:center;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>Members</h2>

<h1 style="color:#1e40af;">
<%= usersCount %>
</h1>

</div>

<div class="card" style="
background:white;
width:220px;
padding:25px;
border-radius:14px;
text-align:center;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>Library</h2>

<h1 style="color:#1e40af;">
<%= libraryCount %>
</h1>

</div>

<div class="card" style="
background:white;
width:220px;
padding:25px;
border-radius:14px;
text-align:center;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>Announcements</h2>

<h1 style="color:#1e40af;">
<%= announcements.length %>
</h1>

</div>

<div class="card" style="
background:white;
width:220px;
padding:25px;
border-radius:14px;
text-align:center;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>Articles</h2>

<h1 style="color:#1e40af;">
<%= posts.length %>
</h1>

</div>

</div>

<div class="quick" style="
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:15px;
margin:30px;
">

<a href="/profile">👤 My Profile</a>

<a href="/library">📚 Library</a>

<a href="/announcements">📢 Announcements</a>

<a href="/chat">💬 Chat</a>

<a href="/admin">⚙️ Admin Panel</a>

<a href="/logout">🚪 Logout</a>

</div>

<style>
.quick a{
background:#2563eb;
color:white;
padding:14px 22px;
text-decoration:none;
border-radius:8px;
font-weight:bold;
}

.quick a:hover{
background:#1d4ed8;
}
</style>

<div class="section" style="
background:white;
margin:25px;
padding:25px;
border-radius:15px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>📈 Recent Activities</h2>

<div style="padding:12px 0;border-bottom:1px solid #eee;">
✅ Welcome to GoodLeaders. Continue growing your leadership skills.
</div>

<div style="padding:12px 0;border-bottom:1px solid #eee;">
📚 Read new leadership articles in the Library section.
</div>

<div style="padding:12px 0;border-bottom:1px solid #eee;">
📢 Check the latest announcements from the administrator.
</div>

<div style="padding:12px 0;border-bottom:1px solid #eee;">
👤 Complete your profile to help other members know you.
</div>

<div style="padding:12px 0;">
🎯 Keep learning and inspiring others every day.
</div>

</div>
<div class="section" style="
background:white;
margin:25px;
padding:25px;
border-radius:15px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>💡 Leadership Tips</h2>

<div style="background:#eff6ff;padding:18px;border-left:5px solid #2563eb;border-radius:8px;margin-bottom:15px;">
<strong>Integrity:</strong> Great leaders always keep their promises.
</div>

<div style="background:#eff6ff;padding:18px;border-left:5px solid #2563eb;border-radius:8px;margin-bottom:15px;">
<strong>Communication:</strong> Listen carefully before making decisions.
</div>

<div style="background:#eff6ff;padding:18px;border-left:5px solid #2563eb;border-radius:8px;margin-bottom:15px;">
<strong>Teamwork:</strong> Success comes from working together.
</div>

<div style="background:#eff6ff;padding:18px;border-left:5px solid #2563eb;border-radius:8px;margin-bottom:15px;">
<strong>Discipline:</strong> Small daily habits create great leaders.
</div>

<div style="background:#eff6ff;padding:18px;border-left:5px solid #2563eb;border-radius:8px;">
<strong>Learning:</strong> Never stop improving yourself.
</div>

</div>

<div class="section" style="
background:white;
margin:25px;
padding:25px;
border-radius:15px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<!-- Advertisement Area -->
<div style="
margin:25px;
padding:20px;
background:#f8fafc;
border:1px dashed #cbd5e1;
border-radius:12px;
text-align:center;
">

<p style="
margin:0;
color:#64748b;
font-size:14px;
">
Advertisement
</p>

<!-- Google AdSense code will be added here after approval -->

</div>

<h2>📰 Latest Leadership Articles</h2>

<% if(posts.length===0){ %>

<p>No leadership articles have been published yet.</p>

<% } else { %>

<% posts.forEach(function(post){ %>

<div style="padding:15px 0;border-bottom:1px solid #eee;">

<h3><%= post.title %></h3>

<p><%= post.content.substring(0,150) %>...</p>

<a href="/article/<%= posts.indexOf(post) %>" style="
display:inline-block;
margin-top:10px;
padding:10px 15px;
background:#2563eb;
color:white;
text-decoration:none;
border-radius:8px;
">
📖 Read Full Article
</a>

</div>

<% }) %>

<% } %>

</div>

<div class="section" style="
background:white;
margin:25px;
padding:25px;
border-radius:15px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
">

<h2>📢 Latest Announcements</h2>

<% if(announcements.length===0){ %>

<p>No announcements available.</p>

<% } else { %>

<% announcements.forEach(function(item){ %>

<div style="padding:15px 0;border-bottom:1px solid #eee;">

<h3><%= item.title %></h3>

<p><%= item.content %></p>

</div>

<% }) %>

<% } %>

</div>

<footer style="
margin-top:40px;
padding:25px;
background:#1e40af;
color:white;
text-align:center;
">

<h3>GoodLeaders Platform</h3>

<div style="
margin:20px auto;
padding:15px;
max-width:600px;
background:#ffffff;
border-radius:10px;
color:#64748b;
">

<p style="margin:0;">
Advertisement
</p>

<!-- Google AdSense code will be added here after approval -->

</div>

<p>Empowering Tomorrow's Leaders.</p>

<p>
<a href="/about" style="color:white;text-decoration:none;">
ℹ️ About Us
</a>
</p>

<p>
<a href="/contact" style="color:white;text-decoration:none;">
📩 Contact Us
</a>
</p>

<p>
<a href="/privacy" style="color:white;text-decoration:none;">
🔒 Privacy Policy
</a>
</p>

<p>
<a href="/terms" style="color:white;text-decoration:none;">
📜 Terms & Conditions
</a>
</p>

<p>
<a href="/cookies" style="color:white;text-decoration:none;">
🍪 Cookie Policy
</a>
</p>

<p>&copy; 2026 GoodLeaders. All Rights Reserved.</p>

</footer>

<script>
document.addEventListener("DOMContentLoaded", function(){

const menuBtn = document.getElementById("menuBtn");
const sidebar = document.getElementById("sidebar");
const overlay = document.getElementById("overlay");

function closeMenu(){
sidebar.classList.remove("show");
overlay.style.display="none";
}

function openMenu(){
sidebar.classList.add("show");
overlay.style.display="block";
}

menuBtn.addEventListener("click",function(e){
e.stopPropagation();

if(sidebar.classList.contains("show")){
closeMenu();
}else{
openMenu();
}
});

overlay.addEventListener("click",closeMenu);

document.querySelectorAll("#sidebar a").forEach(function(link){
link.addEventListener("click",closeMenu);
});

});
</script>

</body>
</html>







