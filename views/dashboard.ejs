<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GoodLeaders Dashboard</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f4f7fb;
color:#222;
}

.header{
background:#1e40af;
color:white;
padding:18px 25px;
display:flex;
align-items:center;
justify-content:space-between;
box-shadow:0 2px 10px rgba(0,0,0,.15);
}

.logo{
font-size:28px;
font-weight:bold;
}

.menu{
display:flex;
gap:15px;
}

.menu a{
color:white;
text-decoration:none;
font-weight:bold;
}

.hero{
background:white;
margin:25px;
padding:30px;
border-radius:15px;
box-shadow:0 3px 15px rgba(0,0,0,.08);
text-align:center;
}

.hero h1{
font-size:34px;
color:#1e40af;
margin-bottom:10px;
}

.hero p{
font-size:18px;
color:#666;
}

.search{
text-align:center;
margin:25px;
}

.search input{
width:70%;
max-width:550px;
padding:14px;
border:1px solid #ddd;
border-radius:8px;
font-size:16px;
}

.stats{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:20px;
margin:30px;
}

.card{
background:white;
width:220px;
padding:25px;
border-radius:14px;
text-align:center;
box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.card h2{
font-size:18px;
color:#555;
margin-bottom:10px;
}

.card h1{
font-size:34px;
color:#1e40af;
}

.quick{
display:flex;
justify-content:center;
flex-wrap:wrap;
gap:15px;
margin:30px;
}

.quick a{
background:#2563eb;
color:white;
padding:14px 22px;
text-decoration:none;
border-radius:8px;
font-weight:bold;
transition:.3s;
}

.quick a:hover{
background:#1d4ed8;
}

.section{
background:white;
margin:25px;
padding:25px;
border-radius:15px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.section h2{
margin-bottom:15px;
color:#1e40af;
}

.activity{
padding:12px 0;
border-bottom:1px solid #eee;
}

.tip{
background:#eff6ff;
padding:18px;
border-left:5px solid #2563eb;
border-radius:8px;
margin-bottom:15px;
}

footer{
margin-top:40px;
padding:25px;
background:#1e40af;
color:white;
text-align:center;
}

@media(max-width:768px){

.search input{
width:95%;
}

.card{
width:100%;
}

.hero h1{
font-size:28px;
}

}

</style>

</head>

<body>

<header class="header">

<div style="display:flex;align-items:center;gap:15px;">

<button onclick="toggleMenu()" style="
background:none;
border:none;
color:white;
font-size:28px;
cursor:pointer;
">
☰
</button>

<div class="logo">
GoodLeaders
</div>
<div id="sidebar" style="
position:fixed;
left:-260px;
top:0;
width:250px;
height:100%;
background:#1e3a8a;
padding-top:70px;
transition:.3s;
z-index:999;
">

<a href="/dashboard" style="display:block;padding:15px 20px;color:white;text-decoration:none;">🏠 Dashboard</a>

<a href="/profile" style="display:block;padding:15px 20px;color:white;text-decoration:none;">👤 Profile</a>

<a href="/library" style="display:block;padding:15px 20px;color:white;text-decoration:none;">📚 Library</a>

<a href="/announcements" style="display:block;padding:15px 20px;color:white;text-decoration:none;">📢 Announcements</a>

<a href="/admin" style="display:block;padding:15px 20px;color:white;text-decoration:none;">⚙️ Admin</a>

<a href="/logout" style="display:block;padding:15px 20px;color:white;text-decoration:none;">🚪 Logout</a>

</div>
</div>

<div class="menu">

<a href="/dashboard">Dashboard</a>

<a href="/profile">Profile</a>

<a href="/library">Library</a>

<a href="/announcements">Announcements</a>

<a href="/logout">Logout</a>

</div>

</header>

<div class="hero">

<h1>Welcome, <%= user %></h1>

<p>Lead with integrity. Inspire people. Build a better future.</p>

</div>

<div class="search">

<input type="text" placeholder="Search articles, announcements or library...">

</div>

<div class="stats">

<div class="card">
<h2>Members</h2>
<h1><%= usersCount %></h1>
</div>

<div class="card">
<h2>Library</h2>
<h1><%= libraryCount %></h1>
</div>

<div class="card">
<h2>Announcements</h2>
<h1><%= announcements.length %></h1>
</div>

<div class="card">
<h2>Articles</h2>
<h1><%= posts.length %></h1>
</div>

</div>
<div class="quick">

<a href="/profile">👤 My Profile</a>

<a href="/library">📚 Library</a>

<a href="/announcements">📢 Announcements</a>

<a href="/admin">⚙️ Admin Panel</a>

<a href="/logout">🚪 Logout</a>

</div>

<div class="section">

<h2>📈 Recent Activities</h2>

<div class="activity">
✅ Welcome to GoodLeaders. Continue growing your leadership skills.
</div>

<div class="activity">
📚 Read new leadership articles in the Library section.
</div>

<div class="activity">
📢 Check the latest announcements from the administrator.
</div>

<div class="activity">
👤 Complete your profile to help other members know you.
</div>

<div class="activity">
🎯 Keep learning and inspiring others every day.
</div>

</div>

<div class="section">

<h2>💡 Leadership Tips</h2>

<div class="tip">
<strong>Integrity:</strong> Great leaders always keep their promises.
</div>

<div class="tip">
<strong>Communication:</strong> Listen carefully before making decisions.
</div>

<div class="tip">
<strong>Teamwork:</strong> Success comes from working together.
</div>

<div class="tip">
<strong>Discipline:</strong> Small daily habits create great leaders.
</div>

<div class="tip">
<strong>Learning:</strong> Never stop improving yourself.
</div>

</div>

<div class="section">

<h2>📰 Latest Leadership Articles</h2>

<% if(posts.length===0){ %>

<p>No leadership articles have been published yet.</p>

<% } else { %>

<% posts.forEach(function(post){ %>

<div class="activity">

<h3><%= post.title %></h3>

<p><%= post.content.substring(0,150) %>...</p>

</div>

<% }) %>

<% } %>
<div class="section">

<h2>📢 Latest Announcements</h2>

<% if(announcements.length===0){ %>

<p>No announcements available.</p>

<% } else { %>

<% announcements.forEach(function(item){ %>

<div class="activity">

<h3><%= item.title %></h3>

<p><%= item.content %></p>

</div>

<% }) %>

<% } %>

</div>

<footer>

<h3>GoodLeaders Platform</h3>

<p>Empowering Tomorrow's Leaders.</p>

<p>&copy; 2026 GoodLeaders. All Rights Reserved.</p>

</footer>
<script>
function toggleMenu(){
const menu = document.getElementById("sidebar");

if(menu.style.left==="0px"){
menu.style.left="-260px";
}else{
menu.style.left="0px";
}
}
</script>
</body>

</html>

